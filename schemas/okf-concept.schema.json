{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenKnowledgeFormatConcept",
  "description": "JSON Schema für YAML-Frontmatter eines Google Open Knowledge Format (OKF v0.2) Dokuments",
  "type": "object",
  "required": ["type", "title"],
  "properties": {
    "id": { "type": "string" },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Obligatorischer OKF-Konzepttyp (z.B. Architecture Concept, iFlow Specification, Decision Record, Data Contract, Test Evidence)"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "resource": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "proposed", "accepted", "verified", "productive", "deprecated"]
    },
    "generated": {
      "type": "object",
      "properties": {
        "by": { "type": "string" },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["contains", "implements", "routesTo", "verifies", "dependsOn", "handlesError", "references"]
          },
          "target": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "resource": { "type": "string" },
          "title": { "type": "string" },
          "author": { "type": "string" }
        }
      }
    }
  }
}
